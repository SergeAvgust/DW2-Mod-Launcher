<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DW2ModLauncherBeta</RootNamespace>
    <AssemblyName>DW2ModLauncherBeta</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DW2ModLauncher.Core\DW2ModLauncher.Core.csproj" />
    <!-- Not linked in: this ships as the standalone DLL the launcher injects via the game's
         low level inject flag (see MainForm.Launch.LoaderDllPath). ReferenceOutputAssembly=false
         keeps it out of DW2ModLauncherBeta's own dependency closure; the Target below copies its
         build output into our own output folder's Loader\ subfolder. -->
    <ProjectReference Include="..\DW2ModLauncher.Loader\DW2ModLauncher.Loader.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Languages\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyLoaderOutput" AfterTargets="Build">
    <MSBuild Projects="..\DW2ModLauncher.Loader\DW2ModLauncher.Loader.csproj" Targets="Build" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="LoaderBuildOutputs" />
    </MSBuild>
    <ItemGroup>
      <LoaderFiles Include="..\DW2ModLauncher.Loader\bin\$(Configuration)\net8.0\DW2ModLauncher.Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LoaderFiles)" DestinationFolder="$(OutDir)Loader" SkipUnchangedFiles="true" />
  </Target>

</Project>
